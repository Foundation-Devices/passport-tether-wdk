+impl server::BlockingArchiveAsyncHandler<SendWdkEvmAccountResponse> for QuantumLinkServer {
+    fn handle(
+        &mut self,
+        request: ArchiveRequest<SendWdkEvmAccountResponse>,
+        _context: &mut ServerContext<Self>,
+    ) {
+        let message = QuantumLinkMessage::WdkEvmAccountResponse(request.message.response.clone());
+        self.send(message, SendOutcome::Respond(request.response)).ok();
+    }
+
+    fn default_response() -> <SendWdkEvmAccountResponse as server::BlockingArchive>::Response {
+        Err(SendMessageError::Cancelled)
+    }
+}
