export component AppWindow inherits BaseWindow {
    width: UISize.screen-width;
    height: UISize.screen-height;
    background: Brand.background;

    if State.page == PageId.welcome: WelcomePage {}
    if State.page == PageId.wallet-choice: WalletChoicePage {}
    if State.page == PageId.recovery: RecoveryPage {}
    if State.page == PageId.wallet-creating: WalletCreatingPage {}
    if State.page == PageId.wallet-ready: WalletReadyPage {}
    if State.page == PageId.pairing: PairingPage {}
    if State.page == PageId.home: HomePage {}
    if State.page == PageId.address: AddressPage {}
    if State.page == PageId.about: AboutPage {}
    if State.page == PageId.disconnect: DisconnectPage {}
    if State.page == PageId.review: ReviewPage {}
    if State.page == PageId.result: ResultPage {}
    if State.page == PageId.error: ErrorPage {}
}
