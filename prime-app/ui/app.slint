component ResultPage inherits BasePage {
    property <bool> circle-revealed: false;
    property <bool> check-revealed: false;
    property <bool> content-revealed: false;

    Timer {
        interval: 120ms;
        running: !root.circle-revealed;
        triggered() => { root.circle-revealed = true; }
    }
    Timer {
        interval: 300ms;
        running: root.circle-revealed && !root.check-revealed;
        triggered() => { root.check-revealed = true; }
    }
    Timer {
        interval: 520ms;
        running: root.check-revealed && !root.content-revealed;
        triggered() => { root.content-revealed = true; }
    }

    background: Brand.background;
    VerticalLayout {
        Header { }
        VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: 15px;
            padding-left: 28px;
            padding-right: 28px;
            HorizontalLayout {
                height: 132px;
                alignment: center;
                Rectangle {
                    width: 132px;
                    height: 132px;
                    background: transparent;

                    Rectangle {
                        width: root.check-revealed ? 130px : 74px;
                        height: self.width;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: self.width / 2;
                        background: transparent;
                        border-width: 2px;
                        border-color: Brand.text;
                        opacity: root.check-revealed ? 0 : 0.45;

                        animate width {
                            duration: 440ms;
                            easing: ease-out;
                        }
                        animate height {
                            duration: 440ms;
                            easing: ease-out;
                        }
                        animate opacity {
                            duration: 440ms;
                            easing: ease-out;
                        }
                    }

                    Rectangle {
                        width: root.circle-revealed ? 112px : 48px;
                        height: self.width;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: self.width / 2;
                        background: Brand.text;
                        opacity: root.circle-revealed ? 1 : 0;

                        Icon {
                            name: "check";
                            size: root.check-revealed ? 52px : 12px;
                            color: Brand.background;
                            opacity: root.check-revealed ? 1 : 0;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;

                            animate size {
                                duration: 360ms;
                                easing: ease-out-back;
                            }
                            animate opacity {
                                duration: 180ms;
                                easing: ease-out;
                            }
                        }

                        animate width {
                            duration: 420ms;
                            easing: ease-out-back;
                        }
                        animate height {
                            duration: 420ms;
                            easing: ease-out-back;
                        }
                        animate opacity {
                            duration: 180ms;
                            easing: ease-out;
                        }
                    }
                }
            }
            Eyebrow {
                text: TR2.lookup(TrId.ResultEyebrow);
                horizontal-alignment: center;
                opacity: root.content-revealed ? 1 : 0;
                animate opacity { duration: 260ms; easing: ease-out; }
            }
            PageTitle {
                text: TR2.lookup(TrId.ResultTitle);
                horizontal-alignment: center;
                opacity: root.content-revealed ? 1 : 0;
                animate opacity { duration: 300ms; easing: ease-out; }
            }
            BodyCopy {
                text: TR2.lookup(TrId.ResultContent);
                font-size: 21px;
                horizontal-alignment: center;
                opacity: root.content-revealed ? 1 : 0;
                animate opacity { duration: 340ms; easing: ease-out; }
            }
            Rectangle {
                height: 80px;
                border-radius: 18px;
                background: Brand.card;
                border-width: 1px;
                border-color: Brand.border;
                opacity: root.content-revealed ? 1 : 0;
                animate opacity { duration: 380ms; easing: ease-out; }
                Icon {
                    x: 18px;
                    y: (parent.height - self.height) / 2;
                    name: "smartphone";
                    size: 27px;
                    color: Brand.text;
                }
                Text {
                    x: 58px;
                    y: 12px;
                    width: parent.width - 74px;
                    height: parent.height - 24px;
                    text: TR2.lookup(TrId.ResultNext);
                    color: Brand.text;
                    font-size: 18px;
                    font-weight: 650;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
            }
        }
        VerticalLayout {
            padding-left: 22px;
            padding-right: 22px;
            padding-bottom: 16px;
            PrimaryAction {
                label: TR2.lookup(TrId.ResultAction);
                clicked => { Callbacks.done(); }
            }
        }
    }
}

