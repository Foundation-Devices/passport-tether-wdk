component BrandSlideToButton inherits Rectangle {
    in property <string> label;
    in property <string> info-label;
    in property <string> activated-label;
    callback activated;

    height: 70px;
    border-radius: 16px;
    background: Brand.card-raised;
    border-width: 1px;
    border-color: Brand.border;

    private property <length> thumb-width: 126px;
    private property <length> edge: 6px;
    private property <length> max-slide-offset: root.width - thumb-width - edge * 2;
    private property <length> slide-offset: min(
        max-slide-offset,
        max(0px, touch-area.pressed ? touch-area.mouse-x - touch-area.pressed-x : 0px)
    );
    private property <bool> has-activated: false;

    if root.has-activated: Text {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        text: root.activated-label;
        color: Brand.text;
        font-size: 20px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if !root.has-activated: HorizontalLayout {
        x: root.thumb-width + root.edge + 8px;
        y: 0px;
        width: root.width - root.thumb-width - root.edge * 2 - 16px;
        height: root.height;
        alignment: center;
        Text {
            text: root.info-label;
            color: Brand.muted;
            font-size: 19px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }

    Rectangle {
        x: root.edge + root.slide-offset;
        y: root.edge;
        width: root.thumb-width;
        height: root.height - root.edge * 2;
        border-radius: 12px;
        background: Brand.text;
        opacity: root.has-activated ? 0 : 1;

        Icon {
            x: 16px;
            y: (parent.height - self.height) / 2;
            name: "chevron-right";
            size: 24px;
            color: Brand.background;
        }
        Text {
            x: 45px;
            y: 0px;
            width: parent.width - 53px;
            height: parent.height;
            text: root.label;
            color: Brand.background;
            font-size: 20px;
            font-weight: 780;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        animate x {
            duration: 80ms;
            easing: ease-out;
        }
    }

    touch-area := TouchArea {
        moved() => {
            if root.slide-offset >= root.max-slide-offset && !root.has-activated {
                root.has-activated = true;
                root.activated();
            }
        }
    }
}

